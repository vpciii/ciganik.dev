    "test:smoke": "SMOKE=1 vitest run tests/smoke"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
